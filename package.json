{
  "name": "roboforge-studio-trial",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Clean-room 3D robotics workbench, pin-to-pin wiring simulator, virtual ESP32 IDE, and 3D physics arena trial for RoboForge",
  "scripts": {
    "dev": "vite --port 8060 --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8060 --host 127.0.0.1",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
